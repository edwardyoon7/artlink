# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 계정/비밀번호 등 민감정보 메모 파일
계정.txt

# 개인정보 원본 자료 보관용 (주소·연락처·개인 작품 등) — Git 추적 제외, 로컬 전용
/private

# uploads & database (personal applicant data)
/uploads
/dev.db
/dev.db-journal

# 작품·굿즈·프로필 사진 등 런타임에 업로드되는 공개 이미지 (public/ 밖에 두는 이유는
# src/app/api/artworks/route.ts의 IMAGE_ROOT 주석 참고 — src/app/*-uploads/[...path]/route.ts가 서빙)
/runtime-uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
