// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  APPLICANT
  ADMIN
  COLLECTOR
}

enum ApplicationType {
  PRO
  AMATEUR
}

enum ApplicationStatus {
  PENDING
  RECEIVED
  APPROVED
  REJECTED
}

model User {
  id                     String            @id @default(cuid())
  name                   String
  email                  String            @unique
  phone                  String
  passwordHash           String
  passwordHintQuestion   String?
  passwordHintAnswerHash String?
  // 로그인 무차별 대입(brute force) 방어용 — src/lib/login-security.ts의 임계값만큼
  // 연속 실패하면 lockedUntil까지 로그인 자체를 거부한다 (src/auth.ts의 authorize 참고)
  failedLoginAttempts    Int               @default(0)
  lockedUntil            DateTime?
  role         Role              @default(APPLICANT)
  artistLevel  ApplicationType?
  createdAt    DateTime          @default(now())
  applications Application[]
  artworks     Artwork[]
  coachingBookings CoachingBooking[]
  goods        Goods[]
  artistProfile ArtistProfile?
  favorites    Favorite[]
}

model Application {
  id          String            @id @default(cuid())
  type        ApplicationType
  status      ApplicationStatus @default(PENDING)
  name        String
  phone       String
  email       String
  education   String?
  career      String?
  exhibitionCount Int?
  motivation  String?
  memo        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id])
  userId      String
  documents   Document[]
}

model Document {
  id            String      @id @default(cuid())
  filename      String
  storedPath    String
  uploadedAt    DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
}

enum ArtworkStatus {
  DRAFT
  LISTED
  SOLD
}

enum ArtworkCategory {
  ORIENTAL_PAINTING
  WESTERN_PAINTING
  SCULPTURE
  OTHER
  UNCATEGORIZED
}

model Artwork {
  id            String          @id @default(cuid())
  title         String
  caption       String?
  description   String?
  price         Int
  imageUrl      String?
  editionNumber String?
  status        ArtworkStatus   @default(DRAFT)
  category      ArtworkCategory @default(UNCATEGORIZED)
  // 실제 작품 크기(cm) — "ARTIEUM VIRTUAL" 가상 배치 미리보기의 비율 계산 기준.
  // ArtworkCategory와 동일하게 기존 등록작에는 값이 없을 수 있어 nullable로 두고,
  // 신규 등록 시에만 폼/API에서 필수로 강제한다.
  widthCm       Float?
  heightCm      Float?
  soldAt        DateTime?
  // 실제 최종 판매가 — 원칙적으로 위탁 등록가(price)와 같아야 하지만, 판매완료 처리 시점에
  // 협상(네고)이 있었다면 실제 거래금액으로 달라질 수 있다. 유통내역(세무 제출용 매출장) ·
  // 정산액 계산은 항상 이 값(없으면 price로 대체)을 기준으로 한다.
  finalPrice    Int?
  buyerName     String?
  buyerContact  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  artist        User            @relation(fields: [artistId], references: [id])
  artistId      String
  payment       Payment?
  favorites     Favorite[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model CoachingBooking {
  id            String        @id @default(cuid())
  curriculum    String
  region        String?
  preferredDate DateTime
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  artist        User          @relation(fields: [artistId], references: [id])
  artistId      String
  instructor    Instructor?   @relation(fields: [instructorId], references: [id])
  instructorId  String?
  payment       Payment?
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Instructor {
  id          String                   @id @default(cuid())
  name        String
  education   String?
  exhibitions String?
  awards      String?
  createdAt   DateTime                 @default(now())
  regions     InstructorRegion[]
  availableDays InstructorAvailability[]
  bookings    CoachingBooking[]
}

model InstructorRegion {
  id           String     @id @default(cuid())
  region       String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorId String

  @@unique([instructorId, region])
}

model InstructorAvailability {
  id           String     @id @default(cuid())
  weekday      Weekday
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorId String

  @@unique([instructorId, weekday])
}

enum PaymentType {
  LISTING_FEE
  COACHING_FEE
  GOODS_IDEA_FEE
  GOODS_PRODUCTION_FEE
  GOODS_SAMPLE_FEE
  PROFILE_FEE
}

enum PaymentStatus {
  WAITING
  CONFIRMED
  REJECTED
}

model Payment {
  id                String            @id @default(cuid())
  type              PaymentType
  amount            Int
  depositorName     String?
  status            PaymentStatus     @default(WAITING)
  confirmedAt       DateTime?
  createdAt         DateTime          @default(now())
  artwork           Artwork?          @relation(fields: [artworkId], references: [id])
  artworkId         String?           @unique
  coachingBooking   CoachingBooking?  @relation(fields: [coachingBookingId], references: [id])
  coachingBookingId String?           @unique
  goods             Goods?            @relation(fields: [goodsId], references: [id])
  goodsId           String?
  artistProfile     ArtistProfile?    @relation(fields: [artistProfileId], references: [id])
  artistProfileId   String?           @unique
}

// 컬렉터(또는 어떤 역할이든 로그인 사용자)가 작품을 찜해두는 기능. 작품이 삭제되면(테스트
// 데이터 정리 스크립트 등) 같이 정리되도록 onDelete: Cascade로 둔다.
model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  artworkId String

  @@unique([userId, artworkId])
}

// 프로 작가 대상 유료 프리미엄 서비스 — 결제 확인(CONFIRMED) 시 isPublished가 true로 전환되며
// 그 순간부터 작품 상세 페이지에 프로필(사진·학력·전시경력·수상경력)이 공개된다.
model ArtistProfile {
  id          String   @id @default(cuid())
  photoUrl    String?
  education   String?
  exhibitions String?
  awards      String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artist      User     @relation(fields: [artistId], references: [id])
  artistId    String   @unique
  payment     Payment?
}

enum GoodsStage {
  REQUESTED
  CONSULTING
  COMMISSIONED
  SAMPLE_REVIEW
  APPROVED
  LISTED
  SOLD_OUT
}

model Goods {
  id             String     @id @default(cuid())
  title          String
  concept        String
  targetAudience String?
  stage          GoodsStage @default(REQUESTED)
  sampleImageUrl String?
  price          Int?
  description    String?
  imageUrl       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  artist         User       @relation(fields: [artistId], references: [id])
  artistId       String
  payments       Payment[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
